[Unit]
Description=Lev-Tech Contact API
After=network.target

[Service]
User=www-data
WorkingDirectory=/var/www/levtech/contact
EnvironmentFile=/var/www/levtech/contact/.env
ExecStart=/usr/bin/node /var/www/levtech/contact/server.js
Restart=always
RestartSec=5
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
