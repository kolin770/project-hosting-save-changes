# .env.example - copy to .env and fill values (DO NOT COMMIT real secrets)

PORT=3000

# Cloudflare Turnstile secret
TURNSTILE_SECRET=your_turnstile_secret_here

# Zoho SMTP credentials
ZOHO_HOST=smtp.zoho.com
ZOHO_PORT=465
ZOHO_USER=info@lev-tech.net
ZOHO_PASS=your_zoho_smtp_app_password_here

# Mail settings
MAIL_FROM=no-reply@lev-tech.net
MAIL_TO=info@lev-tech.net
